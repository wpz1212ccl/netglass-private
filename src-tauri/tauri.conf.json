{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetGlass",
  "version": "0.1.0",
  "identifier": "com.netglass.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NetGlass",
        "width": 320,
        "height": 200,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,msFloatyMode --enable-features=msWebView2TreatAppSuspendAsDeviceSuspend,msWebView2SimulateMemoryPressureWhenInactive"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
